{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ladybugbets.example/contracts/observation-envelope.schema.json",
  "title": "LBOC-001 Observation Envelope",
  "description": "Governed logical envelope of a LadybugBets candidate observation across all three assessment outcomes (ADMITTED / QUARANTINED / REJECTED). Vendor-neutral governance contract, not a database schema. The base shape is permissive enough to REPRESENT a defective REJECTED candidate (so a rejection can be recorded with provenance and a reason); ADMITTED and QUARANTINED candidates must satisfy the stronger conditional invariants below. Price VALUE validity (e.g. decimal > 1) is enforced by the standard-library validator (governance/validate_observation.py), not by this schema; see docs/OBSERVATION_CONTRACT.md for which invariant lives at which layer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "provenance", "source_asserted", "canonical", "governance"],
  "$defs": {
    "admission_state": {
      "type": "string",
      "enum": ["ADMITTED", "QUARANTINED", "REJECTED"]
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "UNRESOLVED_SPORT_IDENTITY",
        "AMBIGUOUS_SPORT_IDENTITY",
        "UNRESOLVED_COMPETITION_IDENTITY",
        "AMBIGUOUS_COMPETITION_IDENTITY",
        "UNRESOLVED_PARTICIPANT_IDENTITY",
        "AMBIGUOUS_PARTICIPANT_IDENTITY",
        "UNRESOLVED_EVENT_IDENTITY",
        "AMBIGUOUS_EVENT_IDENTITY",
        "UNRESOLVED_OPERATOR_IDENTITY",
        "AMBIGUOUS_OPERATOR_IDENTITY",
        "UNRESOLVED_MARKET_IDENTITY",
        "AMBIGUOUS_MARKET_IDENTITY",
        "UNRESOLVED_OUTCOME_IDENTITY",
        "AMBIGUOUS_OUTCOME_IDENTITY",
        "UNRESOLVED_JURISDICTION_IDENTITY",
        "AMBIGUOUS_JURISDICTION_IDENTITY",
        "MISSING_REQUIRED_SOURCE_FIELD",
        "MISSING_SOURCE_LOCATOR",
        "INVALID_PRICE",
        "INVALID_PRICE_FORMAT",
        "MISSING_PROVIDER_PROVENANCE",
        "TEMPORAL_AMBIGUITY",
        "CONFLICTING_SOURCE_ASSERTIONS",
        "INVALID_CONTRACT_VERSION"
      ]
    },
    "supported_price_format": {
      "type": "string",
      "enum": ["decimal", "american", "fractional"]
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    }
  },
  "properties": {
    "contract": {
      "type": "object",
      "description": "Contract metadata.",
      "additionalProperties": false,
      "required": ["contract_version", "observation_id"],
      "properties": {
        "contract_version": {
          "type": "string",
          "description": "Declared contract version. The base shape accepts any syntactically valid semver so INVALID_CONTRACT_VERSION is representable; ADMITTED/QUARANTINED are constrained to 1.0.0 below.",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "observation_id": {
          "type": "string",
          "minLength": 1,
          "description": "LadybugBets opaque, stable identifier. Generation algorithm NOT ratified in Sprint 1."
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Provider/provenance identity and ingestion metadata.",
      "additionalProperties": false,
      "required": ["provider_id", "ingested_at"],
      "properties": {
        "provider_id": {
          "type": ["string", "null"],
          "description": "Governed LadybugBets identity of the upstream provider. Nullable in the base shape so MISSING_PROVIDER_PROVENANCE is representable; required non-empty for ADMITTED/QUARANTINED."
        },
        "source_reference": {
          "type": ["string", "null"],
          "description": "Reference back to the source record/feed. Provenance, not canonical sporting identity."
        },
        "source_record_id": {
          "type": ["string", "null"],
          "description": "Provider-native record identifier, when supplied."
        },
        "ingested_at": {
          "type": "string",
          "format": "date-time",
          "description": "When LadybugBets received/recorded the observation. Ingestion time, never source quote time."
        }
      }
    },
    "source_asserted": {
      "type": "object",
      "description": "Values actually asserted by the upstream source. A provider need not supply every native id; absence remains absence.",
      "additionalProperties": false,
      "required": ["price", "price_format"],
      "properties": {
        "source_event_id": { "type": ["string", "null"] },
        "source_event_name": { "type": ["string", "null"] },
        "source_sport_label": { "type": ["string", "null"] },
        "source_competition_id": { "type": ["string", "null"] },
        "source_competition_label": { "type": ["string", "null"] },
        "source_operator_id": { "type": ["string", "null"] },
        "source_operator_name": { "type": ["string", "null"] },
        "source_market_id": { "type": ["string", "null"] },
        "source_market_label": { "type": ["string", "null"] },
        "source_outcome_id": { "type": ["string", "null"] },
        "source_outcome_label": { "type": ["string", "null"] },
        "source_participants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_participant_id": { "type": ["string", "null"] },
              "source_participant_name": { "type": ["string", "null"] },
              "source_role": { "type": ["string", "null"] }
            }
          }
        },
        "source_start_time": { "type": ["string", "null"] },
        "source_observed_at": {
          "type": ["string", "null"],
          "description": "Source quote-state timestamp, when trustworthy. May be absent/null."
        },
        "source_jurisdiction": { "type": ["string", "null"] },
        "price": {
          "description": "The price as asserted by the source. Left loose in the base shape so a malformed price is representable for a REJECTED candidate; VALUE validity for ADMITTED/QUARANTINED is enforced by the standard-library validator."
        },
        "price_format": {
          "type": ["string", "null"],
          "description": "Declared format. Left as a free string/null in the base shape so INVALID_PRICE_FORMAT is representable; constrained to the supported vocabulary for ADMITTED/QUARANTINED below."
        }
      }
    },
    "canonical": {
      "type": "object",
      "description": "LadybugBets canonical identities. Any unresolved identity is null; never guessed, never copied from the raw form.",
      "additionalProperties": false,
      "properties": {
        "sport": { "type": ["string", "null"] },
        "competition_id": { "type": ["string", "null"] },
        "competition": { "type": ["string", "null"] },
        "event_id": { "type": ["string", "null"] },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "participant_id": { "type": ["string", "null"] },
              "participant_display_name": { "type": ["string", "null"] },
              "role": { "type": ["string", "null"] }
            }
          }
        },
        "operator_id": { "type": ["string", "null"] },
        "operator_display_name": { "type": ["string", "null"] },
        "market_id": { "type": ["string", "null"] },
        "market": { "type": ["string", "null"] },
        "outcome_id": { "type": ["string", "null"] },
        "outcome": { "type": ["string", "null"] },
        "jurisdiction": { "type": ["string", "null"] },
        "start_time": { "type": ["string", "null"] }
      }
    },
    "governance": {
      "type": "object",
      "description": "Admission state, reason codes, and correction/supersession metadata.",
      "additionalProperties": false,
      "required": ["admission_state"],
      "properties": {
        "admission_state": { "$ref": "#/$defs/admission_state" },
        "reason_codes": {
          "type": "array",
          "items": { "$ref": "#/$defs/reason_code" }
        },
        "supersedes_observation_id": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    }
  },
  "allOf": [
    {
      "$comment": "ADMITTED must carry no reason codes.",
      "if": {
        "required": ["governance"],
        "properties": {
          "governance": {
            "required": ["admission_state"],
            "properties": { "admission_state": { "const": "ADMITTED" } }
          }
        }
      },
      "then": {
        "properties": {
          "governance": {
            "properties": { "reason_codes": { "maxItems": 0 } }
          }
        }
      }
    },
    {
      "$comment": "QUARANTINED and REJECTED must carry at least one reason code.",
      "if": {
        "required": ["governance"],
        "properties": {
          "governance": {
            "required": ["admission_state"],
            "properties": { "admission_state": { "enum": ["QUARANTINED", "REJECTED"] } }
          }
        }
      },
      "then": {
        "properties": {
          "governance": {
            "required": ["reason_codes"],
            "properties": { "reason_codes": { "minItems": 1 } }
          }
        }
      }
    },
    {
      "$comment": "ADMITTED/QUARANTINED: supported contract version, governed provenance, a source locator, supported price format.",
      "if": {
        "required": ["governance"],
        "properties": {
          "governance": {
            "required": ["admission_state"],
            "properties": { "admission_state": { "enum": ["ADMITTED", "QUARANTINED"] } }
          }
        }
      },
      "then": {
        "properties": {
          "contract": {
            "properties": { "contract_version": { "const": "1.0.0" } }
          },
          "provenance": {
            "properties": { "provider_id": { "$ref": "#/$defs/nonempty_string" } },
            "anyOf": [
              { "properties": { "source_reference": { "$ref": "#/$defs/nonempty_string" } }, "required": ["source_reference"] },
              { "properties": { "source_record_id": { "$ref": "#/$defs/nonempty_string" } }, "required": ["source_record_id"] }
            ]
          },
          "source_asserted": {
            "properties": { "price_format": { "$ref": "#/$defs/supported_price_format" } }
          }
        }
      }
    },
    {
      "$comment": "ADMITTED: core canonical identities resolved and at least one resolved participant with a role (DEC-017).",
      "if": {
        "required": ["governance"],
        "properties": {
          "governance": {
            "required": ["admission_state"],
            "properties": { "admission_state": { "const": "ADMITTED" } }
          }
        }
      },
      "then": {
        "properties": {
          "canonical": {
            "required": ["event_id", "operator_id", "market_id", "outcome_id", "participants"],
            "properties": {
              "event_id": { "$ref": "#/$defs/nonempty_string" },
              "operator_id": { "$ref": "#/$defs/nonempty_string" },
              "market_id": { "$ref": "#/$defs/nonempty_string" },
              "outcome_id": { "$ref": "#/$defs/nonempty_string" },
              "participants": {
                "type": "array",
                "minItems": 1,
                "contains": {
                  "type": "object",
                  "required": ["participant_id", "role"],
                  "properties": {
                    "participant_id": { "$ref": "#/$defs/nonempty_string" },
                    "role": { "$ref": "#/$defs/nonempty_string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
